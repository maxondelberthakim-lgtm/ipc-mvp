{
  // IPC API — Cloudflare Workers (paket gratis). Deploy: cd cloudflare && npm run deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ipc-api",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": { "LOKASI": "apac" },
  "durable_objects": {
    "bindings": [{ "name": "IPC_DB", "class_name": "IpcDb" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["IpcDb"] }],
  "kv_namespaces": [{ "binding": "BACKUP", "id": "5e314d8f29994479becb08bbb4e8ded3" }],
  // backup harian 02:00 WIB (= 19:00 UTC)
  "triggers": { "crons": ["0 19 * * *"] }
}
